{
  "name": "@triforce-heroes/triforce-lbrs",
  "version": "1.0.0",
  "description": "Extract and rebuild LBRS files.",
  "license": "Apache License 2.0",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./Extract": {
      "types": "./dist/Extract.d.ts",
      "default": "./dist/Extract.js"
    },
    "./Rebuild": {
      "types": "./dist/Rebuild.d.ts",
      "default": "./dist/Rebuild.js"
    }
  },
  "scripts": {
    "build": "rimraf ./dist && tspc -p ./tsconfig.build.json && swc ./dist -d .",
    "watch": "tsx --watch ./tools/watch.ts",
    "oxfmt": "oxfmt --check ./src ./tests",
    "oxfmt:fix": "oxfmt --write ./src ./tests",
    "eslint": "eslint ./src ./tests",
    "eslint:fix": "eslint --fix ./src ./tests",
    "test": "vitest"
  },
  "dependencies": {
    "@triforce-heroes/triforce-core": "github:triforce-heroes/triforce-core"
  },
  "devDependencies": {
    "@rheactor/eslint-config-rheactor": "github:rheactor/eslint-config-rheactor",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.33",
    "@triforce-heroes/triforce-publisher": "github:triforce-heroes/triforce-publisher",
    "@types/node": "^25.9.0",
    "@vitest/coverage-v8": "^4.1.6",
    "eslint": "^10.4.0",
    "oxfmt": "^0.50.0",
    "rimraf": "^6.1.3",
    "ts-patch": "^4.0.1",
    "tsx": "^4.22.2",
    "typescript": "^6.0.3",
    "typescript-transform-paths": "^4.0.0",
    "vitest": "^4.1.6"
  }
}
