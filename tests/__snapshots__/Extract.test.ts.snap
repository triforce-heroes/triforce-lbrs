    ],
    [
      "TXT_DIALOG_CUTSCENE_28_13",
      [
        "I'm sorry, kitty-cat, but I can't. I'm exhausted. We're out of our league here.",
        "I'm sorry, kitty-cat, but I can't. I'm exhausted. We're out of our league here.",
